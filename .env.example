# Public build-time values. Leave blank locally to run without a backend.
# Set the Supabase pair as GitHub Actions *variables* (not secrets) for Pages.
# Never put a service-role key, secret key, or scorer credential in this file.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Placeholder link for the Code Playground button. Not a secret.
VITE_PLAYGROUND_URL=
